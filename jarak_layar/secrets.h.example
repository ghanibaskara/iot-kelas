// Salin berkas ini menjadi "secrets.h" (berkas itu masuk .gitignore), lalu isi nilai asli.
#pragma once

#define WIFI_SSID  "isi_nama_wifi"
#define WIFI_PASS  "isi_password_wifi"

// ThingsBoard Cloud: mqtt.thingsboard.cloud (US) atau mqtt.eu.thingsboard.cloud (EU)
// Pakai host sesuai akun kamu (lihat URL login ThingsBoard).
#define TB_HOST    "mqtt.thingsboard.cloud"
#define TB_TOKEN   "isi_access_token_device"

// Root CA: download "tb-cloud-root-ca.pem" dari dialog "Check connectivity" di halaman device,
// lalu tempel isinya di antara baris BEGIN dan END.
static const char ROOT_CA[] PROGMEM = R"PEMDATA(
-----BEGIN CERTIFICATE-----
TEMPEL_ISI_SERTIFIKAT_DI_SINI
-----END CERTIFICATE-----
)PEMDATA";
